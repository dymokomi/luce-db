import db
import interop
import thread

var ready: @u64
var go: @u64
var advanced: @u64
var conflicts: @u64
var unexpected: @u64

struct Job:
    var database: db.Database*?
    var reader: bool

func current_version(database: db.Database*) -> i64!:
    let snapshot = try database.snapshot()
    defer snapshot.release()
    let version = try snapshot.value().schema("schema", "app")
    if let v = version: return v
    return -1

func work(raw: void*?):
    let job = (Job*)(raw else trap("missing migration job"))
    let database = job.database else trap("missing database")
    discard(ready.add(1, .release))
    while go.load(.acquire) == 0: thread.sleep(1)
    if job.reader:
        for _ in 0..<40:
            let snapshot = database.snapshot() catch failure: trap(failure.message)
            defer snapshot.release()
            let count = snapshot.value().count() catch failure: trap(failure.message)
            if count == 1:
                discard(())
            elif count == 2:
                if not (snapshot.value().contains("user/alice") catch failure: trap(failure.message)):
                    discard(unexpected.add(1, .relaxed))
            else:
                discard(unexpected.add(1, .relaxed))
            thread.sleep(1)
        return
    for attempt in 0..<512:
        let opened: interop.Reference[db.Migration]? = database.begin_migration("schema", "app", 0) catch failure:
            if failure.code == db.conflict or failure.code == db.busy or failure.code == db.timed_out:
                discard(conflicts.add(1, .relaxed))
                let now = current_version(database) catch err: trap(err.message)
                if now == 1: return
                thread.sleep(1)
                recover none
            trap(failure.message)
        let migration = opened else continue
        defer migration.release()
        migration.value().put_text("user/alice", "Alice") catch failure:
            if failure.code == db.conflict:
                discard(conflicts.add(1, .relaxed))
                let now = current_version(database) catch err: trap(err.message)
                if now == 1: return
            else: trap(failure.message)
            return
        let committed = migration.value().commit(1000) catch failure:
            if failure.code == db.conflict or failure.code == db.busy or failure.code == db.timed_out:
                discard(conflicts.add(1, .relaxed))
                let now = current_version(database) catch err: trap(err.message)
                if now == 1: return
                recover -1
            trap(failure.message)
        if committed > 0:
            discard(advanced.add(1, .relaxed))
            return
    let final = current_version(database) catch err: trap(err.message)
    if final == 1: return
    discard(unexpected.add(1, .relaxed))

pub func main(arguments: str[]) -> i32!:
    assert(arguments.length == 2)
    var database = try db.Database(arguments[1])
    defer database.close()
    assert(try database.initialize_schema("schema", "app") == 1)
    var jobs: Job[6]
    var workers: thread.Handle[6]
    for i in 0..<jobs.length:
        jobs[i] = Job(database = &database, reader = i >= 2)
        workers[i] = try thread.spawn(work, &jobs[i], stack = 524288)
    while ready.load(.acquire) < (u64)jobs.length: thread.sleep(1)
    go.store(1, .release)
    for i in 0..<workers.length: try workers[i].join()
    assert(unexpected.load(.acquire) == 0)
    let snapshot = try database.snapshot()
    defer snapshot.release()
    assert((try snapshot.value().schema("schema", "app")) == 1)
    assert(try snapshot.value().count() == 2)
    assert(try snapshot.value().contains("user/alice"))
    assert(advanced.load(.acquire) <= 1)
    print("PASS synchronized two-worker schema migration with concurrent snapshot readers")
    return 0
