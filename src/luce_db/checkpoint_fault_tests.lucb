## Per-store checkpoint publication faults; only harness-owned disposable files.
import c
import files
import io
import memory
import paths
import strings
import luce_db.engine as engine
import luce_db.storage_io as storage
import luce_db.bytes as bytes

struct Audit:
    var kind: usize
    var cut: usize = 18446744073709551615
    var armed: bool
    var randoms: usize
    var creates: usize
    var writes: usize
    var written: usize
    var syncs: usize
    var replacements: usize
    var directories: usize
    var closes: usize
    var removals: usize
    var name: u8[64]
    var name_length: usize

func state(raw: void*?) -> Audit*:
    return (Audit*)(raw else trap("missing checkpoint audit"))

func random(raw: void*?, data: u8[]) -> !:
    let audit = state(raw)
    audit.randoms += 1
    if audit.kind == 1: error(io.failed, "injected checkpoint entropy error")
    if audit.kind == 15 or audit.kind == 16:
        for i in 0..<data.length: data[i] = 0 if audit.kind == 15 or audit.randoms <= 2 else 1
        return
    let normal = storage.Controls()
    try normal.random(none, data)

func create(raw: void*?, directory: files.Directory*, name: c.str) -> files.File!:
    let audit = state(raw)
    audit.creates += 1
    if audit.kind == 2: error(io.failed, "injected checkpoint create error")
    let normal = storage.Controls()
    let file = try normal.create(none, directory, name)
    let text = (str)name
    assert(text.length < audit.name.length)
    memory.copy(audit.name, text.bytes, text.length)
    audit.name_length = text.length
    return file

func write(raw: void*?, file: files.File*, data: const u8[]) -> usize!:
    let audit = state(raw)
    if not audit.armed: return try file.write(data)
    audit.writes += 1
    if audit.kind == 4: return 0
    if audit.kind == 5: return data.length + 1
    if audit.kind == 14 or audit.written == audit.cut: error(io.failed, "injected checkpoint write error")
    var count = data.length
    if audit.kind == 3 and count > 7: count = 7
    if count > audit.cut - audit.written: count = audit.cut - audit.written
    let written = try file.write(data[..<count])
    audit.written += written
    if audit.written == audit.cut: error(io.failed, "injected post-checkpoint-write error")
    return written

func synchronize(raw: void*?, file: files.File*) -> !:
    let audit = state(raw)
    if audit.armed:
        audit.syncs += 1
        if audit.kind == 6: error(io.failed, "injected checkpoint sync error")
    try file.sync()
    if audit.armed and audit.kind == 7: error(io.failed, "injected post-checkpoint-sync error")

func replace(raw: void*?, directory: files.Directory*, source: c.str, target: c.str, published: bool*) -> !:
    let audit = state(raw)
    audit.replacements += 1
    assert(audit.syncs == 1)
    if audit.kind == 8: error(io.failed, "injected pre-rename error")
    try storage.replace(none, directory, source, target, published)
    if audit.kind == 9: error(io.failed, "injected post-rename error")

func directory_sync(raw: void*?, directory: files.Directory*) -> !:
    let audit = state(raw)
    if audit.armed:
        audit.directories += 1
        assert(audit.replacements == 1 and audit.syncs == 1)
        if audit.kind == 10: error(io.failed, "injected checkpoint directory sync error")
    try storage.sync_directory(directory)
    if audit.armed and audit.kind == 11: error(io.failed, "injected post-checkpoint-directory-sync error")

func close(raw: void*?, file: files.File*) -> !:
    let audit = state(raw)
    audit.closes += 1
    assert(audit.directories == 1)
    if audit.kind == 12: error(io.failed, "injected old descriptor close error")
    try file.close()
    if audit.kind == 13: error(io.failed, "injected post-close error")

func remove(raw: void*?, directory: files.Directory*, name: c.str) -> !:
    let audit = state(raw)
    audit.removals += 1
    if audit.kind == 14: error(io.failed, "injected cleanup error")
    try storage.remove(none, directory, name)

func controls(audit: Audit*) -> storage.Controls:
    return storage.Controls(context = audit, random = random, create = create,
        write = write, sync = synchronize, replace = replace, directory_sync = directory_sync,
        close = close, remove = remove)

func seed(path: str) -> !:
    let store = try engine.open(path)
    defer engine.drop(store)
    for index in 0..<10:
        var tx = try engine.transaction(store)
        defer tx.close()
        try tx.put("key", b"val")
        assert(try tx.commit() == (u64)index + 1)

func one(path: str, kind: usize, cut: usize = 18446744073709551615) -> !:
    try seed(path)
    let original = try files.read_limit((c.str)path, 4096)
    defer free(original)
    var audit = Audit(kind = kind, cut = cut)
    let store = try engine.open(path, controls(&audit))
    var view = try engine.snapshot(store)
    defer view.close()
    var tx = try engine.transaction(store)
    defer tx.close()
    engine.drop(store)
    let directory_name = try strings.copy(paths.directory(path))
    defer strings.release(directory_name)
    var directory = try files.Directory.open((c.str)directory_name)
    defer directory.destroy()
    let collision = ".luce-db-00000000000000000000000000000000"
    if kind == 15 or kind == 16:
        var existing = try directory.open_file((c.str)collision, files.OpenMode.create_new_read_write)
        try io.write_all(&existing, b"unrelated collision sentinel")
        existing.destroy()
    audit.armed = true
    var refused = false
    let poisoned = kind >= 9 and kind <= 13
    let success = (kind == 0 and cut == 18446744073709551615) or kind == 3 or kind == 16
    discard(engine.checkpoint(store, 1000) catch failure:
        let expected = bytes.uncertain if poisoned else (bytes.busy if kind == 15 else (io.no_progress if kind == 4 else (io.invalid_count if kind == 5 else io.failed)))
        assert(failure.code == expected)
        refused = true
        recover 0)
    assert(refused != success)
    assert(view.generation == 10 and try view.get("key") != none)
    let stats = engine.statistics(store)
    assert(stats.generation == 10 and stats.records == 1 and stats.needs_reopen == poisoned)
    assert(stats.journal_bytes == (94 if success else (i64)original.length))
    if not poisoned and not success:
        let actual = try files.read_limit((c.str)path, 4096)
        defer free(actual)
        assert(bytes.compare(actual, original) == 0, "pre-publication failure changed journal")
    if poisoned:
        var blocked: usize
        let next: engine.View? = engine.snapshot(store) catch failure:
            assert(failure.code == bytes.uncertain)
            blocked += 1
            recover none
        assert(next == none)
        discard(engine.checkpoint(store) catch failure:
            assert(failure.code == bytes.uncertain)
            blocked += 1
            recover 0)
        discard(tx.commit() catch failure:
            assert(failure.code == bytes.uncertain)
            blocked += 1
            recover 0)
        assert(blocked == 3)
    if kind == 15 or kind == 16:
        assert(audit.randoms == (128 if kind == 15 else 3))
        assert(audit.creates == audit.randoms)
        var existing = try directory.open_file((c.str)collision)
        var sentinel: u8[28]
        try io.read_exact(&existing, sentinel)
        assert((str)sentinel == "unrelated collision sentinel")
        existing.destroy()
        try storage.remove(none, &directory, (c.str)collision)
    if audit.name_length > 0:
        let name = (str)audit.name[..<audit.name_length]
        let remains: files.Metadata? = directory.entry_metadata((c.str)name, follow_symlinks = false) catch failure:
            assert(failure.code == files.missing)
            recover none
        assert((remains != none) == (kind == 14))
        if kind == 14:
            assert(audit.removals == 1)
            try storage.remove(none, &directory, (c.str)name)
    audit.armed = false
    tx.close()
    var locked = false
    let other: engine.Store*? = engine.open(path) catch failure:
        assert(failure.code == bytes.busy)
        locked = true
        recover none
    assert(locked and other == none)
    view.close()
    let reopened = try engine.open(path)
    defer engine.drop(reopened)
    assert(engine.statistics(reopened).generation == 10)
    assert(try engine.checkpoint(reopened) == 10)
    var after = try engine.transaction(reopened)
    defer after.close()
    try after.put("after", b"recovery")
    assert(try after.commit() == 11)

pub func main(arguments: str[]) -> i32!:
    assert(arguments.length == 2)
    var scratch: u8[4096]
    for kind in 0..<(usize)17:
        try one(try format(scratch, f"{arguments[1]}-mode-{kind}"), kind)
    for cut in 0..<(usize)95:
        try one(try format(scratch, f"{arguments[1]}-cut-{cut}"), 0, cut)
    print("PASS 112 checkpoint write/entropy/create/sync/rename/directory/close/cleanup/collision fault scenarios")
    return 0
