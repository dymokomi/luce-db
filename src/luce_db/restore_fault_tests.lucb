## Fail each observed restore I/O boundary before/after its native operation.
import c
import files
import io
import luce_db.engine as engine
import luce_db.backup as backup
import luce_db.storage_io as storage
from luce_db.bytes import uncertain, compare

struct Trace:
    var calls: usize
    var fail_at: usize
    var after: bool
    var published: bool
    var failed: bool

func state(raw: void*?) -> Trace*:
    return (Trace*)(raw else trap("missing restore trace"))

func enter(trace: Trace*) -> usize!:
    trace.calls += 1
    if trace.calls == trace.fail_at and not trace.after:
        trace.failed = true
        error(io.failed, "injected restore boundary failure")
    return trace.calls

func leave(trace: Trace*, ticket: usize) -> !:
    if ticket == trace.fail_at and trace.after:
        trace.failed = true
        error(io.failed, "injected restore post-boundary failure")

func random(raw: void*?, bytes: u8[]) -> !:
    let trace = state(raw)
    let ticket = try enter(trace)
    let normal = storage.Controls()
    try normal.random(none, bytes)
    try leave(trace, ticket)

func create(raw: void*?, directory: files.Directory*, name: c.str) -> files.File!:
    let trace = state(raw)
    let ticket = try enter(trace)
    let normal = storage.Controls()
    var file = try normal.create(none, directory, name)
    ## A callback that reports failed creation owns any unreturned descriptor.
    errdefer file.destroy()
    leave(trace, ticket) catch failure:
        try storage.remove(none, directory, name)
        error(failure.code, failure.message)
    return file

func read(raw: void*?, file: files.File*, data: u8[]) -> usize!:
    let trace = state(raw)
    let ticket = try enter(trace)
    let count = try file.read(data)
    try leave(trace, ticket)
    return count

func write(raw: void*?, file: files.File*, data: const u8[]) -> usize!:
    let trace = state(raw)
    let ticket = try enter(trace)
    let count = try file.write(data)
    try leave(trace, ticket)
    return count

func synchronize(raw: void*?, file: files.File*) -> !:
    let trace = state(raw)
    let ticket = try enter(trace)
    try file.sync()
    try leave(trace, ticket)

func close(raw: void*?, file: files.File*) -> !:
    let trace = state(raw)
    let ticket = try enter(trace)
    try file.close()
    try leave(trace, ticket)

func publish(raw: void*?, directory: files.Directory*, source: c.str, target: c.str, possible: bool*) -> !:
    let trace = state(raw)
    let ticket = try enter(trace)
    try storage.publish(none, directory, source, target, possible)
    trace.published = true
    try leave(trace, ticket)

func directory_sync(raw: void*?, directory: files.Directory*) -> !:
    let trace = state(raw)
    let ticket = try enter(trace)
    try storage.sync_directory(directory)
    try leave(trace, ticket)

func one(source: str, target: str, at: usize, after: bool) -> usize!:
    var trace = Trace(fail_at = at, after = after)
    let controls = storage.Controls(context = &trace, random = random, create = create,
        read = read, write = write, sync = synchronize, close = close, publish = publish,
        directory_sync = directory_sync)
    var refused = false
    discard(backup.restore(source, target, controls) catch failure:
        assert(trace.failed and (failure.code == uncertain) == trace.published)
        refused = true
        recover backup.Info(0, 0, 0))
    assert(refused == (at > 0) and trace.failed == refused)
    let exists: files.Metadata? = files.metadata((c.str)target) catch failure:
        assert(failure.code == files.missing)
        recover none
    assert((exists != none) == trace.published)
    if not trace.published: discard(try backup.restore(source, target))
    let input = try files.read_limit((c.str)source, 4096)
    defer free(input)
    let output = try files.read_limit((c.str)target, 4096)
    defer free(output)
    assert(compare(input, output) == 0)
    let store = try engine.open(target)
    assert(engine.statistics(store).generation == 1)
    engine.drop(store)
    return trace.calls

pub func main(arguments: str[]) -> i32!:
    assert(arguments.length == 2)
    let store = try engine.open(arguments[1])
    defer engine.drop(store)
    var tx = try engine.transaction(store)
    defer tx.close()
    try tx.put("key", b"val")
    assert(try tx.commit() == 1)
    var source_buffer: u8[4096]
    let source = try format(source_buffer, f"{arguments[1]}.backup")
    discard(try engine.backup_to(store, source))
    var baseline_buffer: u8[4096]
    let baseline = try format(baseline_buffer, f"{arguments[1]}.baseline")
    let count = try one(source, baseline, 0, false)
    assert(count > 10 and count < 100)
    var cases: usize
    for after in [false, true]:
        for at in 1..<count + 1:
            var buffer: u8[4096]
            discard(try one(source, try format(buffer, f"{arguments[1]}-{after}-{at}"), at, after))
            cases += 1
    print(f"PASS {cases} restore before/after failures across {count} observed I/O boundaries, exact bytes and retries")
    return 0
