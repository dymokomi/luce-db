import db
import c
import files
import luce_db.engine as engine
import luce_db.backup as backup
from luce_db.bytes import compare

pub func main(arguments: str[]) -> i32!:
    assert(arguments.length == 2)
    var source_name: u8[4096]
    var export_name: u8[4096]
    var restore_name: u8[4096]
    var empty_name: u8[4096]
    let source = try format(source_name, f"{arguments[1]}-source")
    let exported = try format(export_name, f"{arguments[1]}-export")
    let restored = try format(restore_name, f"{arguments[1]}-restore")
    let empty = try format(empty_name, f"{arguments[1]}-empty")
    var database = try db.Database(source)
    defer database.close()
    let blank = try database.backup(empty)
    assert(blank.generation == 0 and blank.records == 0 and blank.bytes == 64)
    assert((try db.verify_backup(empty)).generation == 0)
    let tx = try database.begin()
    defer tx.release()
    try tx.value().put("binary", b"\0\xff")
    try tx.value().put("empty", b"")
    try tx.value().put_text("unicode/猫", "value")
    assert(try tx.value().commit() == 1)
    let view = try database.snapshot()
    defer view.release()
    let value = try view.value().get("binary") else trap("missing value")
    defer value.release()
    let before = try files.read_limit((c.str)source, 4096)
    defer free(before)
    let info = try database.backup(exported)
    assert(info.generation == 1 and info.records == 3 and info.bytes > 64)
    assert((try db.verify_backup(exported)).bytes == info.bytes)
    let after = try files.read_limit((c.str)source, 4096)
    defer free(after)
    assert(compare(before, after) == 0)
    assert(try view.value().generation() == 1 and compare(try value.value().bytes(), b"\0\xff") == 0)
    let restored_info = try db.restore_backup(exported, restored)
    assert(restored_info.generation == 1 and restored_info.records == 3 and restored_info.bytes == info.bytes)
    var other = try db.Database(restored)
    defer other.close()
    let snap = try other.snapshot()
    defer snap.release()
    assert(try snap.value().count() == 3)
    let binary = try snap.value().get("binary") else trap("restored value missing")
    defer binary.release()
    assert(compare(try binary.value().bytes(), b"\0\xff") == 0)
    let next = try other.begin()
    defer next.release()
    try next.value().put_text("after", "restore")
    assert(try next.value().commit() == 2)
    assert(try other.checkpoint() == 2)
    var refused = false
    discard(database.backup(exported) catch failure:
        assert(failure.code == files.already_exists)
        refused = true
        recover db.BackupInfo(0, 0, 0))
    assert(refused)
    database.close()
    refused = false
    discard(database.backup(exported) catch failure:
        assert(failure.code == db.closed)
        refused = true
        recover db.BackupInfo(0, 0, 0))
    assert(refused)
    print("PASS backup native/Luce facade, generations, source preservation, retained views, binary/empty/UTF-8, restore and subsequent checkpoint")
    return 0
