## Database server over prism.Store. Process, listen/connect, token auth. Storage is Prism.
import interop
import memory
import prism

pub struct Database:
    var store: interop.Reference[prism.Store]
    var alive: bool

    pub func init():
        return

    pub static func open(path: str, token: str) -> interop.Reference[Database]!:
        if token.length == 0:
            error(prism.invalid, "database token is required")
        let native = try new Database() in memory.heap
        errdefer native.close()
        native.store = try prism.Store.open(path, token = token)
        native.alive = true
        return try interop.Reference[Database].adopt(native, database_type, memory.heap)

    pub func snapshot() -> interop.Reference[prism.Session]!:
        if not self.alive:
            error(prism.closed, "database is closed")
        return try self.store.value().snapshot()

    pub func begin() -> interop.Reference[prism.Session]!:
        if not self.alive:
            error(prism.closed, "database is closed")
        return try self.store.value().begin()

    pub func listen() -> !:
        if not self.alive:
            error(prism.closed, "database is closed")
        try self.store.value().listen()

    pub func listen_tls(host: str, port: u16) -> u16!:
        if not self.alive:
            error(prism.closed, "database is closed")
        return try self.store.value().listen_tls(host, port)

    pub func tls_issuer_x() -> const u8[]!:
        if not self.alive:
            error(prism.closed, "database is closed")
        return try self.store.value().tls_issuer_x()

    pub func tls_issuer_y() -> const u8[]!:
        if not self.alive:
            error(prism.closed, "database is closed")
        return try self.store.value().tls_issuer_y()

    pub func serve() -> !:
        if not self.alive:
            error(prism.closed, "database is closed")
        try self.store.value().serve()

    pub func store() -> prism.Store*!:
        if not self.alive:
            error(prism.closed, "database is closed")
        return try self.store.value()

    pub func bake(wait_ms: i64 = 0) -> i64!:
        if not self.alive:
            error(prism.closed, "database is closed")
        return try self.store.value().bake(wait_ms)

    pub mutating func close():
        if not self.alive:
            return
        self.alive = false
        self.store.release()

    pub static func connect(socket_path: str, token: str) -> interop.Reference[Database]!:
        if token.length == 0:
            error(prism.invalid, "database token is required")
        let store = try prism.Store.connect(socket_path, token)
        let native = try new Database() in memory.heap
        errdefer native.close()
        native.store = store
        native.alive = true
        return try interop.Reference[Database].adopt(native, database_type, memory.heap)

    pub static func connect_tls(host: str, port: u16, token: str, issuer_x: const u8[], issuer_y: const u8[]) -> interop.Reference[Database]!:
        if token.length == 0:
            error(prism.invalid, "database token is required")
        let store = try prism.Store.connect_tls(host, port, token, issuer_x, issuer_y)
        let native = try new Database() in memory.heap
        errdefer native.close()
        native.store = store
        native.alive = true
        return try interop.Reference[Database].adopt(native, database_type, memory.heap)

pub let database_type = interop.Type[Database]("Prism database", Database.close, closeable = true)
