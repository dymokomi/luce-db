import c
import files
import io
import thread
import luce_db.engine as engine
import luce_db.storage_io as storage
import luce_db.bytes as bytes

struct Gate:
    var phase: usize
    var armed: bool
    var entered: @u32
    var released: @u32

func state(raw: void*?) -> Gate*:
    return (Gate*)(raw else trap("missing checkpoint gate"))

func pause(gate: Gate*, phase: usize):
    if gate.armed and (gate.phase == phase or (gate.phase == 3 and phase == 1)):
        gate.entered.store(1, .release)
        while gate.released.load(.acquire) == 0: thread.sleep(1)

func synchronize(raw: void*?, file: files.File*) -> !:
    try file.sync()
    pause(state(raw), 0)

func replace(raw: void*?, directory: files.Directory*, source: c.str, target: c.str, published: bool*) -> !:
    try storage.replace(none, directory, source, target, published)
    let gate = state(raw)
    pause(gate, 1)
    if gate.phase == 3: error(io.failed, "injected gated post-rename failure")

func directory_sync(raw: void*?, directory: files.Directory*) -> !:
    try storage.sync_directory(directory)
    pause(state(raw), 2)

struct Job:
    var store: engine.Store*
    var commit: bool
    var result: u64
    var uncertain: bool

func work(raw: void*?):
    let job = (Job*)(raw else trap("missing checkpoint job"))
    if job.commit:
        var tx = engine.transaction(job.store) catch failure: trap(failure.message)
        defer tx.close()
        tx.put("next", b"new") catch failure: trap(failure.message)
        job.result = tx.commit(5000) catch failure:
            assert(failure.code == bytes.uncertain)
            job.uncertain = true
            recover 0
    else:
        job.result = engine.checkpoint(job.store, 5000) catch failure:
            assert(failure.code == bytes.uncertain)
            job.uncertain = true
            recover 0

func wait_queue(store: engine.Store*, count: i64):
    for i in 0..<5000:
        if engine.statistics(store).waiting_writers == count: return
        thread.sleep(1)
    trap("checkpoint queue readiness timeout")

func one(path: str, phase: usize) -> !:
    var gate = Gate(phase = phase)
    let hooks = storage.Controls(context = &gate, sync = synchronize, replace = replace, directory_sync = directory_sync)
    let store = try engine.open(path, hooks)
    defer engine.drop(store)
    var tx = try engine.transaction(store)
    defer tx.close()
    try tx.put("base", b"old")
    assert(try tx.commit() == 1)
    var old = try engine.snapshot(store)
    defer old.close()
    gate.armed = true
    var first = Job(store = store)
    var writer = Job(store = store, commit = true)
    var second = Job(store = store)
    let first_thread = try thread.spawn(work, &first, stack = 524288)
    for i in 0..<5000:
        if gate.entered.load(.acquire) == 1: break
        thread.sleep(1)
    assert(gate.entered.load(.acquire) == 1)
    let writer_thread = try thread.spawn(work, &writer, stack = 524288)
    wait_queue(store, 1)
    let second_thread = try thread.spawn(work, &second, stack = 524288)
    wait_queue(store, 2)
    var during = try engine.snapshot(store)
    assert(during.generation == 1 and try during.get("next") == none)
    during.close()
    assert(engine.statistics(store).generation == 1)
    gate.released.store(1, .release)
    try first_thread.join()
    try writer_thread.join()
    try second_thread.join()
    assert(engine.statistics(store).waiting_writers == 0)
    assert(old.generation == 1 and try old.get("next") == none)
    if phase == 3:
        assert(first.uncertain and writer.uncertain and second.uncertain)
        assert(engine.statistics(store).generation == 1 and engine.statistics(store).needs_reopen)
    else:
        assert(not first.uncertain and not writer.uncertain and not second.uncertain)
        assert(first.result == 1 and writer.result == 2 and second.result == 2)
        assert(engine.statistics(store).generation == 2 and engine.statistics(store).records == 2)
        var after = try engine.snapshot(store)
        assert(try after.get("next") != none)
        after.close()

pub func main(arguments: str[]) -> i32!:
    assert(arguments.length == 2)
    var scratch: u8[4096]
    for phase in 0..<(usize)4:
        try one(try format(scratch, f"{arguments[1]}-{phase}"), phase)
    print("PASS 4 gated checkpoint/commit/FIFO/reader/publication-failure concurrency scenarios")
    return 0
