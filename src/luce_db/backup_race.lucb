## Same-destination concurrent creation without HTTP, for the publication race gate.
import c
import files
import thread
import luce_db.engine as engine
from luce_db.bytes import busy

struct Gate:
    var released: @u32

struct Job:
    var store: engine.Store*?
    var path: str
    var gate: Gate*?
    var succeeded: bool
    var unexpected: bool
    var message: str
    var missing: bool
    var number: i32

func work(raw: void*?):
    let job = (Job*)(raw else trap("missing backup race job"))
    let gate = job.gate else trap("missing backup race gate")
    let store = job.store else trap("missing backup race store")
    while gate.released.load(.acquire) == 0: thread.sleep(1)
    discard(engine.backup_to(store, job.path) catch failure:
        if failure.code != files.already_exists and failure.code != busy:
            job.unexpected = true
            job.message = failure.message
            job.missing = failure.code == files.missing
            job.number = c.errno()
        return)
    job.succeeded = true

pub func main(arguments: str[]) -> i32!:
    assert(arguments.length == 2)
    let store = try engine.open(arguments[1])
    defer engine.drop(store)
    var tx = try engine.transaction(store)
    defer tx.close()
    try tx.put("key", b"val")
    discard(try tx.commit())
    for round in 0..<100:
        var scratch: u8[4096]
        let target = try format(scratch, f"{arguments[1]}-race-{round}")
        var gate: Gate
        var jobs: Job[8]
        var workers: thread.Handle[8]
        for i in 0..<jobs.length:
            jobs[i] = Job(store = store, path = target, gate = &gate)
            workers[i] = try thread.spawn(work, &jobs[i], stack = 524288)
        gate.released.store(1, .release)
        for i in 0..<workers.length: try workers[i].join()
        var winners: usize
        for job in jobs:
            if job.unexpected:
                print(f"RACE ERROR round={round} errno={job.number} missing={job.missing}: {job.message}")
                return 1
            if job.succeeded: winners += 1
        assert(winners == 1)
    print("PASS 100 eight-thread backup destination races")
    return 0
