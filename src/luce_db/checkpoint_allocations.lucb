## Replace memory.heap only in this single-threaded test; restore before owner exit.
import memory
import luce_db.engine as engine

struct Block:
    var address: u8*?
    var size: usize

struct Heap: memory.Allocator:
    var parent: memory.Allocator
    var blocks: Block[128]
    var attempts: usize
    var fail_at: usize
    var persistent: bool
    var refused: usize
    var live: usize
    var live_bytes: usize
    var peak: usize

    mutating func arm(at: usize, persistent: bool = false):
        assert(self.live == 0 and self.live_bytes == 0)
        self.attempts = 0
        self.fail_at = at
        self.persistent = persistent
        self.refused = 0
        self.peak = 0

    pub mutating func allocate(size: usize, alignment: usize) -> u8[]?:
        self.attempts += 1
        if self.fail_at > 0 and (self.attempts == self.fail_at or (self.persistent and self.attempts >= self.fail_at)):
            self.refused += 1
            return none
        let data = self.parent.allocate(size, alignment) else trap("upstream allocation failed")
        assert(data.length == size and size > 0)
        for block in self.blocks: assert(block.address != data.data)
        for i in 0..<self.blocks.length:
            if self.blocks[i].address == none:
                self.blocks[i] = Block(address = data.data, size = size)
                self.live += 1
                self.live_bytes += size
                if self.live_bytes > self.peak: self.peak = self.live_bytes
                return data
        trap("checkpoint allocation ledger full")

    pub mutating func resize(data: u8[], size: usize) -> bool:
        discard(data)
        discard(size)
        return false

    pub mutating func release(data: u8[]):
        for i in 0..<self.blocks.length:
            if self.blocks[i].address == data.data:
                assert(self.blocks[i].size == data.length)
                self.live -= 1
                self.live_bytes -= data.length
                self.blocks[i] = Block()
                self.parent.release(data)
                return
        trap("foreign/double checkpoint free")

func restore(parent: memory.Allocator):
    memory.heap = parent

func probe_write(store: engine.Store*, heap: Heap*, at: usize, persistent: bool = false) -> usize!:
    heap.arm(at, persistent)
    let original = memory.heap
    memory.heap = heap
    defer restore(original)
    var refused = false
    let result = engine.checkpoint(store) catch failure:
        assert(failure.code == memory.exhausted and at > 0)
        refused = true
        recover 0
    assert(refused == (at > 0))
    if not refused: assert(result == 2)
    assert(not engine.statistics(store).needs_reopen)
    assert(heap.live == 0 and heap.live_bytes == 0)
    assert(heap.refused == (1 if at > 0 else 0))
    return heap.attempts

func probe_open(path: str, heap: Heap*, at: usize, persistent: bool = false) -> usize!:
    heap.arm(at, persistent)
    let original = memory.heap
    memory.heap = heap
    defer restore(original)
    let store: engine.Store*? = engine.open(path) catch failure:
        assert(failure.code == memory.exhausted and at > 0)
        recover none
    assert((store == none) == (at > 0))
    if let opened = store:
        assert(engine.statistics(opened).generation == 2 and engine.statistics(opened).records == 2)
        engine.drop(opened)
    assert(heap.live == 0 and heap.live_bytes == 0)
    assert(heap.refused == (1 if at > 0 else 0))
    return heap.attempts

pub func main(arguments: str[]) -> i32!:
    assert(arguments.length == 2)
    let store = try engine.open(arguments[1])
    for index in 0..<2:
        var tx = try engine.transaction(store)
        defer tx.close()
        try tx.put("first" if index == 0 else "second", b"value")
        assert(try tx.commit() == (u64)index + 1)
    var heap = Heap(parent = memory.heap)
    let writes = try probe_write(store, &heap, 0)
    assert(writes == 1 and heap.peak == 65536, "checkpoint buffering is no longer one bounded allocation")
    var cases: usize
    for persistent in [false, true]:
        for at in 1..<writes + 1:
            assert(try probe_write(store, &heap, at, persistent) == at)
            cases += 1
    discard(try probe_write(store, &heap, 0))
    engine.drop(store)
    let opens = try probe_open(arguments[1], &heap, 0)
    assert(opens > 5 and opens < 128)
    for persistent in [false, true]:
        for at in 1..<opens + 1:
            assert(try probe_open(arguments[1], &heap, at, persistent) == at)
            cases += 1
            ## A clean successful retry also proves failed open released its lock.
            assert(try probe_open(arguments[1], &heap, 0) == opens)
    print(f"PASS {cases} checkpoint allocation-failure paths; write allocations={writes}, write peak=65536, reopen allocations={opens}; no live blocks")
    return 0
