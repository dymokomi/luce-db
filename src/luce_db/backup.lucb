## Immutable format-002 exports and verified no-overwrite restores. Native only.
## Input files and parent directories must be trusted and externally immutable.
import c
import files
import memory
import paths
import platform
import strings
import luce_db.checkpoint as checkpoint
import luce_db.storage_io as storage
import luce_db.tree as tree
from luce_db.bytes import compare, invalid, corrupt, busy, uncertain

extern func flock(descriptor: i32, flags: i32) -> i32

pub struct Info:
    pub let generation: i64
    pub let records: i64
    pub let bytes: i64

struct Location:
    var directory: files.Directory
    var name: str
    var owner: memory.Allocator?
    var lock_file: files.File

    mutating func close():
        self.lock_file.destroy()
        self.directory.destroy()
        if self.name.length > 0:
            let owner = self.owner else trap("backup name allocator lost")
            with owner: strings.release(self.name)
            self.name = ""

    mutating func own_destination() -> !:
        var scratch: u8[4096]
        let name = try format(scratch, f"{self.name}.lock")
        self.lock_file = storage.open_lock_file(&self.directory, (c.str)name) catch failure:
            error(failure.code, "backup destination sidecar open failed")
        let metadata = try self.lock_file.metadata()
        if metadata.kind != files.FileKind.regular or metadata.links != 1:
            error(invalid, "backup destination lock must be regular/single-link")
        let descriptor = self.lock_file.descriptor() else error(invalid, "backup lock is closed")
        if flock(descriptor, 6) != 0: error(busy, "backup destination already owned or locking failed")
        try self.check_lock()
        let existing: files.Metadata? = self.directory.entry_metadata((c.str)self.name, follow_symlinks = false) catch failure:
            if failure.code != files.missing: error(failure.code, failure.message)
            recover none
        if existing != none: error(files.already_exists, "backup destination exists")

    mutating func check_lock() -> !:
        var scratch: u8[4096]
        let name = try format(scratch, f"{self.name}.lock")
        try named_identity(&self.directory, &self.lock_file, name)

func location(path: str) -> Location!:
    if platform.windows: error(invalid, "backup currently requires POSIX")
    if path.length == 0 or strings.contains(path, "\0"): error(invalid, "invalid backup path")
    let parent = try strings.copy(paths.directory(path))
    defer strings.release(parent)
    var result: Location
    errdefer result.close()
    result.owner = memory.heap
    with memory.heap: result.name = try strings.copy(paths.base(path))
    if result.name == "" or result.name == "." or result.name == "..": error(invalid, "backup needs a filename")
    result.directory = try files.Directory.open((c.str)parent, follow_symlinks = false)
    return result

func same(a: files.Metadata, b: files.Metadata) -> bool:
    return a.kind == files.FileKind.regular and b.kind == files.FileKind.regular and a.links == 1 and b.links == 1 and a.device == b.device and a.inode == b.inode and a.size == b.size and a.modified.seconds == b.modified.seconds and a.modified.nanoseconds == b.modified.nanoseconds and a.changed.seconds == b.changed.seconds and a.changed.nanoseconds == b.changed.nanoseconds

func named_identity(directory: files.Directory*, file: files.File*, name: str) -> !:
    let opened = try file.metadata()
    let named = try directory.entry_metadata((c.str)name, follow_symlinks = false)
    if not same(opened, named): error(invalid, "backup pathname identity changed")

## Never sync/repair/truncate an input; exact EOF excludes even a valid WAL tail.
pub func inspect(file: files.File*, controls: storage.Controls = storage.Controls()) -> Info!:
    let before = try file.metadata()
    if before.kind != files.FileKind.regular or before.links != 1: error(invalid, "backup must be regular/single-link")
    if before.size < 64 or before.size > checkpoint.max_bytes: error(corrupt, "invalid backup size")
    discard(try file.seek(0))
    var magic: u8[16]
    try storage.read_exact(file, controls, magic)
    if compare(magic, checkpoint.header.bytes) != 0: error(corrupt, "backup requires a complete format-002 base")
    let base = try checkpoint.read(file, controls, before.size, build_index = false)
    assert(base.root == none)
    if base.end != before.size: error(corrupt, "backup contains trailing bytes")
    var extra: u8[1]
    if try controls.read(controls.context, file, extra) != 0: error(corrupt, "backup changed or has trailing data")
    if not same(before, try file.metadata()): error(invalid, "backup input changed during verification")
    return Info((i64)base.generation, (i64)base.records, base.end)

pub func verify(path: str, controls: storage.Controls = storage.Controls()) -> Info!:
    var input = try location(path)
    defer input.close()
    var file = try input.directory.open_file((c.str)input.name, files.OpenMode.read, follow_symlinks = false, nonblocking = true)
    defer file.destroy()
    try named_identity(&input.directory, &file, input.name)
    let result = try inspect(&file, controls)
    try named_identity(&input.directory, &file, input.name)
    try controls.close(controls.context, &file)
    return result

func cleanup(directory: files.Directory*, file: files.File*, name: str, controls: storage.Controls) -> !:
    let named: files.Metadata? = directory.entry_metadata((c.str)name, follow_symlinks = false) catch failure:
        if failure.code != files.missing: error(failure.code, failure.message)
        recover none
    if let metadata = named:
        let opened = try file.metadata()
        if metadata.kind != files.FileKind.regular or metadata.device != opened.device or metadata.inode != opened.inode:
            error(invalid, "backup temporary name changed; cleanup refused")
        try controls.remove(controls.context, directory, (c.str)name)

func cleanup_if_owned(directory: files.Directory*, file: files.File*, name: str*, owned: bool*, controls: storage.Controls):
    if *owned:
        cleanup(directory, file, *name, controls) catch failure: discard(failure)

func temporary(directory: files.Directory*, controls: storage.Controls, scratch: u8[], name: str*) -> files.File!:
    for attempt in 0..<128:
        var random: u8[16]
        try controls.random(controls.context, random)
        var encoded: u8[32]
        let digits = "0123456789abcdef".bytes
        for i in 0..<16:
            encoded[i * 2] = digits[random[i] >> 4]
            encoded[i * 2 + 1] = digits[random[i] & 15]
        *name = try format(scratch, f".luce-backup-{(str)encoded}")
        let file = controls.create(controls.context, directory, (c.str)*name) catch failure:
            if failure.code == files.already_exists: continue
            error(failure.code, "backup temporary open failed")
        return file
    error(busy, "no unused backup temporary name")

func copy(input: files.File*, output: files.File*, size: i64, controls: storage.Controls) -> !:
    let buffer = try alloc u8[checkpoint.buffer_size] in memory.heap
    defer free(buffer) in memory.heap
    discard(try input.seek(0))
    var remaining = size
    while remaining > 0:
        let length = (usize)(remaining if remaining < (i64)buffer.length else (i64)buffer.length)
        try storage.read_exact(input, controls, buffer[..<length])
        try storage.write_all(output, controls, buffer[..<length])
        remaining -= (i64)length
    var extra: u8[1]
    if try controls.read(controls.context, input, extra) != 0: error(corrupt, "restore input changed size")

func write_output(path: str, root: tree.Node*?, info: Info, controls: storage.Controls, input: files.File*? = none, input_location: Location*? = none, input_initial: files.Metadata? = none) -> Info!:
    var destination = try location(path)
    defer destination.close()
    try destination.own_destination()
    var scratch: u8[64]
    var name: str
    var file = try temporary(&destination.directory, controls, scratch, &name)
    defer file.destroy()
    var owned = true
    defer cleanup_if_owned(&destination.directory, &file, &name, &owned, controls)
    let initial = try file.metadata()
    if initial.kind != files.FileKind.regular or initial.links != 1 or initial.size != 0:
        error(invalid, "invalid backup temporary file")
    if let source = input:
        let before = input_initial else trap("restore input metadata missing")
        if not same(before, try source.metadata()): error(invalid, "restore input changed before copy")
        try copy(source, &file, info.bytes, controls)
        if not same(before, try source.metadata()): error(invalid, "restore input changed during copy")
        let place = input_location else trap("restore input location missing")
        try named_identity(&place.directory, source, place.name)
        try controls.close(controls.context, source)
    else:
        try checkpoint.write(&file, controls, root, (u64)info.generation, info.bytes)
    try controls.sync(controls.context, &file)
    let verified = try inspect(&file, controls)
    if verified.generation != info.generation or verified.records != info.records or verified.bytes != info.bytes:
        error(corrupt, "prepared backup metadata differs from captured snapshot")
    try named_identity(&destination.directory, &file, name)
    try destination.check_lock()
    var published = false
    controls.publish(controls.context, &destination.directory, (c.str)name, (c.str)destination.name, &published) catch failure:
        if published: error(uncertain, "backup publication outcome uncertain; verify destination")
        error(failure.code, failure.message)
    owned = false
    named_identity(&destination.directory, &file, destination.name) catch failure:
        error(uncertain, "published backup identity uncertain; verify destination")
    controls.directory_sync(controls.context, &destination.directory) catch failure:
        error(uncertain, "published backup directory sync failed; verify destination")
    controls.close(controls.context, &file) catch failure:
        error(uncertain, "published backup close failed; verify destination")
    return verified

## Caller owns an immutable root for the entire operation; no engine/writer lock.
pub func export_root(root: tree.Node*?, generation: u64, path: str, controls: storage.Controls = storage.Controls()) -> Info!:
    let size = try checkpoint.measure(root, generation)
    return try write_output(path, root, Info((i64)generation, (i64)tree.count(root), size), controls)

pub func restore(path: str, destination: str, controls: storage.Controls = storage.Controls()) -> Info!:
    var input = try location(path)
    defer input.close()
    var file = try input.directory.open_file((c.str)input.name, files.OpenMode.read, follow_symlinks = false, nonblocking = true)
    defer file.destroy()
    try named_identity(&input.directory, &file, input.name)
    let before = try file.metadata()
    let info = try inspect(&file, controls)
    if not same(before, try file.metadata()): error(invalid, "restore input changed during validation")
    return try write_output(destination, none, info, controls, &file, &input, before)
