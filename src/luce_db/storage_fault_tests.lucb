## Deterministic native I/O faults; only disposable paths from the test harness.
import c
import files
import io
import memory
import thread
import luce_db.engine as engine
import luce_db.journal as journal
import luce_db.storage_io as storage
import luce_db.bytes as bytes

struct Audit:
    var write_cut: usize = 18446744073709551615
    var read_cut: usize = 18446744073709551615
    var chunk: usize = 18446744073709551615
    var written: usize
    var read_bytes: usize
    var writes: usize
    var reads: usize
    var syncs: usize
    var directories: usize
    var truncates: usize
    var bad_write: usize
    var bad_read: usize
    var sync_failure: usize
    var directory_failure: usize
    var truncate_failure: usize
    var inspect: engine.Store*?
    var expected_generation: i64
    var gate: bool
    var entered: @u32
    var released: @u32

func audit(raw: void*?) -> Audit*:
    return (Audit*)(raw else trap("missing I/O audit"))

func write(raw: void*?, file: files.File*, data: const u8[]) -> usize!:
    let state = audit(raw)
    state.writes += 1
    assert(data.length > 0)
    if state.bad_write == 1: return 0
    if state.bad_write == 2: return data.length + 1
    if state.written == state.write_cut: error(io.failed, "injected write error")
    var count = data.length
    if count > state.chunk: count = state.chunk
    if count > state.write_cut - state.written: count = state.write_cut - state.written
    let transferred = try file.write(data[..<count])
    state.written += transferred
    ## Includes errors AFTER a complete frame reaches the OS but before any ACK.
    if state.written == state.write_cut: error(io.failed, "injected error after write")
    return transferred

func read(raw: void*?, file: files.File*, buffer: u8[]) -> usize!:
    let state = audit(raw)
    state.reads += 1
    assert(buffer.length > 0)
    if state.bad_read == 1: return 0
    if state.bad_read == 2: return buffer.length + 1
    if state.read_bytes == state.read_cut: error(io.failed, "injected read error")
    var count = buffer.length
    if count > state.chunk: count = state.chunk
    if count > state.read_cut - state.read_bytes: count = state.read_cut - state.read_bytes
    let transferred = try file.read(buffer[..<count])
    state.read_bytes += transferred
    if state.read_bytes == state.read_cut: error(io.failed, "injected error after read")
    return transferred

func check_unpublished(state: Audit*) -> !:
    if let store = state.inspect:
        let diagnostic = engine.statistics(store)
        assert(diagnostic.generation == state.expected_generation)
        assert(not diagnostic.needs_reopen)
        var view = try engine.snapshot(store)
        defer view.close()
        assert(view.generation == (u64)state.expected_generation)
        assert(try view.get("next") == none, "publish before sync returned")

func synchronize(raw: void*?, file: files.File*) -> !:
    let state = audit(raw)
    state.syncs += 1
    try check_unpublished(state)
    if state.gate:
        state.entered.store(1, .release)
        while state.released.load(.acquire) == 0: thread.sleep(1)
    if state.sync_failure == 1: error(io.failed, "injected error before fsync")
    try file.sync()
    try check_unpublished(state)
    if state.sync_failure == 2: error(io.failed, "injected error after fsync")

func directory_sync(raw: void*?, directory: files.Directory*) -> !:
    let state = audit(raw)
    state.directories += 1
    assert(state.syncs == 1, "directory sync before file sync")
    if state.directory_failure == 1: error(io.failed, "injected directory sync error")
    try storage.sync_directory(directory)
    if state.directory_failure == 2: error(io.failed, "injected post-directory-sync error")

func truncate(raw: void*?, file: files.File*, size: i64) -> !:
    let state = audit(raw)
    state.truncates += 1
    if state.truncate_failure == 1: error(io.failed, "injected truncate error")
    try file.truncate(size)
    if state.truncate_failure == 2: error(io.failed, "injected post-truncate error")

func controls(state: Audit*) -> storage.Controls:
    return storage.Controls(context = state, read = read, write = write,
        sync = synchronize, truncate = truncate, directory_sync = directory_sync)

func seed(path: str) -> !:
    let store = try engine.open(path)
    defer engine.drop(store)
    var tx = try engine.transaction(store)
    defer tx.close()
    try tx.put("base", b"old")
    assert(try tx.commit() == 1)

func same_file(path: str, expected: const u8[]) -> !:
    let actual = try files.read_limit((c.str)path, 4096)
    defer free(actual)
    assert(bytes.compare(actual, expected) == 0, "unexpected journal mutation")

func check_state(path: str, generation: u64, has_next: bool) -> !:
    let store = try engine.open(path)
    defer engine.drop(store)
    var view = try engine.snapshot(store)
    defer view.close()
    assert(view.generation == generation)
    if generation > 0:
        let item = try view.get("base") else trap("lost acknowledged record")
        assert(bytes.compare(item.value.span(), b"old") == 0)
    let next = try view.get("next")
    assert((next != none) == has_next)
    if let item = next: assert(bytes.compare(item.value.span(), b"new") == 0)

func fails_open(path: str, state: Audit*, expected: ErrorCode = io.failed) -> !:
    var refused = false
    let store: engine.Store*? = engine.open(path, controls(state)) catch failure:
        assert(failure.code == expected)
        refused = true
        recover none
    assert(refused and store == none)

func commit_case(path: str, kind: usize, cut: usize) -> !:
    try seed(path)
    var state = Audit(chunk = 7)
    let store = try engine.open(path, controls(&state))
    ## The retained views deliberately outlive this initial store reference below.
    var before = try engine.snapshot(store)
    defer before.close()
    var tx = try engine.transaction(store)
    defer tx.close()
    var queued = try engine.transaction(store)
    defer queued.close()
    engine.drop(store)
    try tx.put("next", b"new")
    try queued.put("unrelated", b"must not append")
    state.written = 0
    state.writes = 0
    state.syncs = 0
    state.directories = 0
    state.inspect = store
    state.expected_generation = 1
    if kind == 0: state.write_cut = cut
    if kind == 1 or kind == 2: state.bad_write = kind
    if kind == 3 or kind == 4: state.sync_failure = kind - 2
    var refused = false
    let result = tx.commit() catch failure:
        assert(failure.code == bytes.uncertain)
        refused = true
        recover 0
    let success = kind == 5
    assert(refused != success)
    assert(before.generation == 1 and try before.get("next") == none)
    let diagnostic = engine.statistics(store)
    assert(diagnostic.needs_reopen == refused)
    assert(diagnostic.generation == (2 if success else 1))
    assert(diagnostic.journal_bytes == (112 if success else 64))
    if success:
        assert(result == 2 and state.writes == 7 and state.syncs == 1)
    else:
        assert(state.syncs == (1 if kind == 3 or kind == 4 else 0))
        let attempts = state.writes
        var caught: usize
        let missing: engine.View? = engine.snapshot(store) catch failure:
            assert(failure.code == bytes.uncertain)
            caught += 1
            recover none
        assert(missing == none)
        discard(tx.commit(100) catch failure:
            assert(failure.code == bytes.uncertain)
            caught += 1
            recover 0)
        discard(queued.commit(100) catch failure:
            assert(failure.code == bytes.uncertain)
            caught += 1
            recover 0)
        assert(caught == 3 and state.writes == attempts)
    state.inspect = none
    tx.close()
    queued.close()
    var lock_refused = false
    let owner: engine.Store*? = engine.open(path) catch failure:
        assert(failure.code == bytes.busy)
        lock_refused = true
        recover none
    assert(lock_refused and owner == none, "snapshot lost process ownership")
    before.close()
    let full = success or kind == 3 or kind == 4 or (kind == 0 and cut == 48)
    try check_state(path, 2 if full else 1, full)
    ## Successful retry after reopening appends at the recovered boundary.
    let reopened = try engine.open(path)
    defer engine.drop(reopened)
    var retry = try engine.transaction(reopened)
    defer retry.close()
    try retry.put("after", b"recovery")
    assert(try retry.commit() == (3 if full else 2))

func creation(path: str, kind: usize, cut: usize) -> !:
    var state = Audit(chunk = 3)
    if kind == 0: state.write_cut = cut
    if kind == 1 or kind == 2: state.sync_failure = kind
    if kind == 3 or kind == 4: state.directory_failure = kind - 2
    try fails_open(path, &state)
    assert(state.truncates == 0)
    assert(state.syncs == (0 if kind == 0 else 1))
    assert(state.directories == (1 if kind >= 3 else 0))
    if kind == 0 and cut < 16:
        var clean = Audit()
        try fails_open(path, &clean, bytes.corrupt)
        try same_file(path, journal.header.bytes[..<cut])
    else:
        try check_state(path, 0, false)

func replay_case(path: str, kind: usize, cut: usize) -> !:
    try seed(path)
    let source = try engine.open(path)
    var tx = try engine.transaction(source)
    try tx.put("next", b"new")
    assert(try tx.commit() == 2)
    tx.close()
    engine.drop(source)
    let original = try files.read_limit((c.str)path, 4096)
    defer free(original)
    var state = Audit(chunk = 3)
    if kind == 0: state.read_cut = cut
    else: state.bad_read = kind
    try fails_open(path, &state, io.failed if kind == 0 else (io.unexpected_eof if kind == 1 else io.invalid_count))
    assert(state.writes == 0 and state.syncs == 0 and state.truncates == 0)
    try same_file(path, original)
    try check_state(path, 2, true)

func recovery_case(path: str, kind: usize) -> !:
    try seed(path)
    let original = try files.read_limit((c.str)path, 4096)
    defer free(original)
    var file = try files.File.open((c.str)path, files.OpenMode.append)
    try io.write_all(&file, b"TXN")
    file.destroy()
    var state = Audit()
    if kind < 2: state.truncate_failure = kind + 1
    else: state.sync_failure = kind - 1
    try fails_open(path, &state)
    assert(state.truncates == 1 and state.writes == 0)
    assert(state.syncs == (0 if kind < 2 else 1))
    if kind != 0: try same_file(path, original)
    try check_state(path, 1, false)
    try same_file(path, original)

func reopen_case(path: str, kind: usize) -> !:
    try seed(path)
    let original = try files.read_limit((c.str)path, 4096)
    defer free(original)
    var state = Audit(chunk = 1)
    if kind < 2: state.sync_failure = kind + 1
    elif kind < 4: state.directory_failure = kind - 1
    if kind < 4:
        ## Repeat on the unchanged complete file: errors must not leak its lock
        ## or turn a subsequent failed durability barrier into a successful open.
        for replay_attempt in 0..<2:
            state.syncs = 0
            state.directories = 0
            try fails_open(path, &state)
            assert(state.syncs == 1)
            assert(state.directories == (0 if kind < 2 else 1))
            assert(state.writes == 0 and state.truncates == 0)
            try same_file(path, original)
    else:
        let store = try engine.open(path, controls(&state))
        assert(state.reads == 64 and state.syncs == 1 and state.directories == 1)
        assert(state.writes == 0 and state.truncates == 0)
        engine.drop(store)
    try check_state(path, 1, false)

struct Worker:
    var store: engine.Store*
    var caught: bool

func attempt(raw: void*?):
    let worker = (Worker*)(raw else trap("missing worker"))
    var tx = engine.transaction(worker.store) catch failure: trap(failure.message)
    defer tx.close()
    tx.put("next", b"new") catch failure: trap(failure.message)
    discard(tx.commit(5000) catch failure:
        assert(failure.code == bytes.uncertain)
        worker.caught = true
        recover 0)

func concurrent(path: str, independent_path: str) -> !:
    try seed(path)
    var state = Audit()
    let store = try engine.open(path, controls(&state))
    assert(state.syncs == 1 and state.directories == 1)
    state.syncs = 0
    state.directories = 0
    state.sync_failure = 2
    state.gate = true
    var view = try engine.snapshot(store)
    var first = Worker(store = store)
    var second = Worker(store = store)
    let first_handle = try thread.spawn(attempt, &first, stack = 524288)
    ## Bound readiness polling. Child failure is never treated as a successful wait.
    for i in 0..<5000:
        if state.entered.load(.acquire) != 0: break
        thread.sleep(1)
    assert(state.entered.load(.acquire) == 1)
    let second_handle = try thread.spawn(attempt, &second, stack = 524288)
    for i in 0..<5000:
        if engine.statistics(store).waiting_writers == 1: break
        thread.sleep(1)
    assert(engine.statistics(store).waiting_writers == 1)
    assert(engine.statistics(store).generation == 1)
    assert(not engine.statistics(store).needs_reopen)
    var during = try engine.snapshot(store)
    assert(during.generation == 1 and try during.get("next") == none)
    during.close()
    ## This store has unrelated controls and must commit while the first is gated.
    var other_state = Audit(chunk = 2)
    let other = try engine.open(independent_path, controls(&other_state))
    var other_tx = try engine.transaction(other)
    try other_tx.put("base", b"old")
    assert(try other_tx.commit() == 1)
    other_tx.close()
    engine.drop(other)
    assert(other_state.syncs == 2 and other_state.directories == 1)
    state.released.store(1, .release)
    try first_handle.join()
    try second_handle.join()
    assert(first.caught and second.caught)
    assert(state.writes == 1 and state.syncs == 1, "queued writer appended after poison")
    assert(engine.statistics(store).waiting_writers == 0)
    assert(engine.statistics(store).needs_reopen)
    assert(view.generation == 1 and try view.get("next") == none)
    view.close()
    engine.drop(store)
    try check_state(path, 2, true)
    try check_state(independent_path, 1, false)

pub func main(arguments: str[]) -> i32!:
    assert(arguments.length == 2)
    var scratch: u8[4096]
    var cases: usize
    for cut in 0..<(usize)49:
        try commit_case(try format(scratch, f"{arguments[1]}-commit-{cut}"), 0, cut)
        cases += 1
    for kind in 1..<(usize)6:
        try commit_case(try format(scratch, f"{arguments[1]}-commit-mode-{kind}"), kind, 0)
        cases += 1
    for cut in 0..<(usize)17:
        try creation(try format(scratch, f"{arguments[1]}-create-{cut}"), 0, cut)
        cases += 1
    for kind in 1..<(usize)5:
        try creation(try format(scratch, f"{arguments[1]}-create-mode-{kind}"), kind, 0)
        cases += 1
    for cut in 0..<(usize)113:
        try replay_case(try format(scratch, f"{arguments[1]}-read-{cut}"), 0, cut)
        cases += 1
    for kind in 1..<(usize)3:
        try replay_case(try format(scratch, f"{arguments[1]}-read-mode-{kind}"), kind, 0)
        cases += 1
    for kind in 0..<(usize)4:
        try recovery_case(try format(scratch, f"{arguments[1]}-recover-{kind}"), kind)
        cases += 1
    for kind in 0..<(usize)5:
        try reopen_case(try format(scratch, f"{arguments[1]}-reopen-{kind}"), kind)
        cases += 1
    var other: u8[4096]
    try concurrent(try format(scratch, f"{arguments[1]}-concurrent"),
        try format(other, f"{arguments[1]}-independent"))
    cases += 1
    assert(cases == 200)
    print(f"PASS {cases} deterministic journal I/O and concurrent-reader/queued-writer/isolation cases")
    return 0
