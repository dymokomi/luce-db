## Scoped heap accounting; no worker threads exist while memory.heap is replaced.
import memory
import luce_db.engine as engine
import luce_db.schema as schema
from luce_db.bytes import Buffer

struct Block:
    var address: u8*?
    var size: usize

struct Heap: memory.Allocator:
    var parent: memory.Allocator
    var blocks: Block[128]
    var attempts: usize
    var fail_at: usize
    var persistent: bool
    var refused: usize
    var live: usize
    var live_bytes: usize

    pub mutating func allocate(size: usize, alignment: usize) -> u8[]?:
        self.attempts += 1
        if self.fail_at > 0 and (self.attempts == self.fail_at or (self.persistent and self.attempts >= self.fail_at)):
            self.refused += 1
            return none
        let data = self.parent.allocate(size, alignment) else trap("upstream allocation failed")
        for i in 0..<self.blocks.length:
            if self.blocks[i].address == none:
                self.blocks[i] = Block(address = data.data, size = size)
                self.live += 1
                self.live_bytes += size
                return data
        trap("schema allocation ledger full")

    pub mutating func resize(data: u8[], size: usize) -> bool:
        discard(data)
        discard(size)
        return false

    pub mutating func release(data: u8[]):
        for i in 0..<self.blocks.length:
            if self.blocks[i].address == data.data:
                assert(self.blocks[i].size == data.length)
                self.live -= 1
                self.live_bytes -= data.length
                self.blocks[i] = Block()
                self.parent.release(data)
                return
        self.parent.release(data)

func restore_heap(parent: memory.Allocator):
    memory.heap = parent

func fail_initialize(store: engine.Store*, at: usize, persistent: bool) -> usize!:
    let original = memory.heap
    var heap = Heap(parent = original, fail_at = at, persistent = persistent)
    memory.heap = &heap
    defer restore_heap(original)
    var refused = false
    discard(schema.initialize(store, "schema", "app") catch failure:
        assert(failure.code == memory.exhausted, failure.message)
        refused = true
        recover 0)
    assert(refused)
    assert(heap.refused >= 1)
    return heap.attempts

func fail_migrate(store: engine.Store*, at: usize, persistent: bool) -> usize!:
    let original = memory.heap
    var heap = Heap(parent = original, fail_at = at, persistent = persistent)
    memory.heap = &heap
    defer restore_heap(original)
    var refused = false
    var migration = schema.begin(store, "schema", "app", 0) catch failure:
        assert(failure.code == memory.exhausted)
        refused = true
        recover schema.Migration()
    if not refused:
        defer migration.close()
        migration.put("user", b"alice") catch failure:
            assert(failure.code == memory.exhausted)
            refused = true
            recover ()
        if not refused:
            discard(migration.commit() catch failure:
                assert(failure.code == memory.exhausted)
                refused = true
                recover 0)
    assert(refused)
    assert(heap.refused >= 1)
    return heap.attempts

pub func main(arguments: str[]) -> i32!:
    assert(arguments.length == 2)
    var cases: usize
    let original = memory.heap
    var probe = Heap(parent = original, fail_at = 1, persistent = false)
    memory.heap = &probe
    var dummy: Buffer
    var encoded = schema.encode("app", 0) catch failure:
        assert(failure.code == memory.exhausted)
        recover dummy
    memory.heap = original
    if probe.refused == 0:
        encoded.close()
        trap("heap interceptor did not refuse encode")
    let baseline = try engine.open(arguments[1])
    defer engine.drop(baseline)
    assert(try schema.initialize(baseline, "schema", "app") == 1)
    var inits: usize = 1
    for persistent in [false, true]:
        for at in 1..<(usize)9:
            var name: u8[4096]
            let path = try format(name, f"{arguments[1]}-init-{persistent}-{at}")
            let store = try engine.open(path)
            defer engine.drop(store)
            let attempts = try fail_initialize(store, at, persistent)
            if at == 1 and not persistent: inits = attempts
            var view = try engine.snapshot(store)
            defer view.close()
            assert((try schema.current(view, "schema", "app")) == none)
            assert(try schema.initialize(store, "schema", "app") == 1)
            cases += 1
    print(f"ALLOCATIONS schema operation=0 count={inits}")
    var migrates: usize = 1
    for persistent in [false, true]:
        for at in 1..<(usize)13:
            var name: u8[4096]
            let path = try format(name, f"{arguments[1]}-migrate-{persistent}-{at}")
            let store = try engine.open(path)
            defer engine.drop(store)
            assert(try schema.initialize(store, "schema", "app") == 1)
            let attempts = try fail_migrate(store, at, persistent)
            if at == 1 and not persistent: migrates = attempts
            var view = try engine.snapshot(store)
            assert((try schema.current(view, "schema", "app")) == 0)
            assert(try view.get("user") == none)
            view.close()
            var migration = try schema.begin(store, "schema", "app", 0)
            defer migration.close()
            try migration.put("user", b"alice")
            assert(try migration.commit() == 2)
            cases += 1
    print(f"ALLOCATIONS schema operation=1 count={migrates}")
    print(f"PASS {cases} schema init/migration heap-failure paths; records and version unchanged after refusal")
    return 0
