import luce_db.db as db
import c
import files
import interop
import luce_db.checkpoint as checkpoint
import luce_db.bytes as bytes

pub func main(arguments: str[]) -> i32!:
    assert(arguments.length == 2)
    var database = try db.Database(arguments[1])
    defer database.close()
    let empty = try database.snapshot()
    defer empty.release()
    assert(try database.checkpoint() == 0)
    assert((try database.statistics()).journal_bytes == 64)
    for index in 0..<20:
        let tx = try database.begin()
        defer tx.release()
        var scratch: u8[32]
        try tx.value().put_text("hot", try format(scratch, f"{index}"))
        assert(try tx.value().commit() == index + 1)
    let snapshot = try database.snapshot()
    defer snapshot.release()
    let retained = try snapshot.value().get("hot") else trap("missing checkpoint value")
    defer retained.release()
    let pending = try database.begin()
    defer pending.release()
    try pending.value().put_text("later", "same generation survives checkpoint")
    let stale = try database.begin()
    defer stale.release()
    let size_before = (try database.statistics()).journal_bytes
    let metadata_before = try files.metadata((c.str)arguments[1])
    for invalid_wait in [-1, 60001]:
        var refused = false
        discard(database.checkpoint(invalid_wait) catch failure:
            assert(failure.code == db.invalid)
            refused = true
            recover -1)
        assert(refused)
    assert(try database.checkpoint(100) == 20)
    let diagnostic = try database.statistics()
    assert(diagnostic.generation == 20 and diagnostic.records == 1)
    assert(diagnostic.journal_bytes == 93 and diagnostic.journal_bytes < size_before)
    assert((try files.metadata((c.str)arguments[1])).inode != metadata_before.inode)
    assert(try empty.value().count() == 0)
    assert(try snapshot.value().generation() == 20)
    assert(try retained.value().text() == "19")
    assert(try pending.value().commit() == 21)
    assert(try database.checkpoint() == 21)
    var conflict = false
    discard(stale.value().commit() catch failure:
        assert(failure.code == db.conflict)
        conflict = true
        recover -1)
    assert(conflict)
    stale.value().close()
    snapshot.value().close()
    empty.value().close()
    database.close()
    var closed = false
    discard(database.checkpoint() catch failure:
        assert(failure.code == db.closed)
        closed = true
        recover -1)
    assert(closed)
    var reopened = try db.Database(arguments[1])
    defer reopened.close()
    assert((try reopened.statistics()).generation == 21)
    assert(try retained.value().text() == "19")
    let remove = try reopened.begin()
    defer remove.release()
    try remove.value().remove("hot")
    try remove.value().remove("later")
    assert(try remove.value().commit() == 22)
    assert(try reopened.checkpoint() == 22)
    assert((try reopened.statistics()).journal_bytes == 64)
    reopened.close()
    var final = try db.Database(arguments[1])
    defer final.close()
    assert((try final.statistics()).generation == 22 and (try final.statistics()).records == 0)
    var rejected = false
    discard(checkpoint.measure(none, 9223372036854775808) catch failure:
        assert(failure.code == bytes.limit)
        rejected = true
        recover 0)
    assert(rejected)
    print("PASS checkpoint generation, size reclamation, snapshots, retained values, transaction compatibility, empty/repeated/reopen/closed bounds")
    return 0
