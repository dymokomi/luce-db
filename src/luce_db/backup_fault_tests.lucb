## Test-only deterministic backup I/O boundaries and owned orphan cleanup.
import c
import files
import io
import memory
import paths
import strings
import luce_db.engine as engine
import luce_db.backup as backup
import luce_db.storage_io as storage
from luce_db.bytes import compare, uncertain, busy

struct Audit:
    var kind: usize
    var cut: usize = 18446744073709551615
    var written: usize
    var randoms: usize
    var creates: usize
    var reads: usize
    var syncs: usize
    var publications: usize
    var directories: usize
    var closes: usize
    var removed: usize
    var name: u8[64]
    var name_size: usize

func state(raw: void*?) -> Audit*:
    return (Audit*)(raw else trap("missing backup audit"))

func random(raw: void*?, data: u8[]) -> !:
    let audit = state(raw)
    audit.randoms += 1
    if audit.kind == 1: error(io.failed, "backup entropy failure")
    if audit.kind == 17 or audit.kind == 18:
        for i in 0..<data.length: data[i] = 0 if audit.kind == 17 or audit.randoms <= 2 else 1
    else:
        let normal = storage.Controls()
        try normal.random(none, data)

func create(raw: void*?, directory: files.Directory*, name: c.str) -> files.File!:
    let audit = state(raw)
    audit.creates += 1
    if audit.kind == 2: error(io.failed, "backup create failure")
    let normal = storage.Controls()
    let file = try normal.create(none, directory, name)
    let text = (str)name
    memory.copy(audit.name, text.bytes, text.length)
    audit.name_size = text.length
    return file

func write(raw: void*?, file: files.File*, data: const u8[]) -> usize!:
    let audit = state(raw)
    if audit.kind == 4: return 0
    if audit.kind == 5: return data.length + 1
    if audit.kind == 15 or audit.written == audit.cut: error(io.failed, "backup write failure")
    var length = data.length
    if audit.kind == 3 and length > 7: length = 7
    if length > audit.cut - audit.written: length = audit.cut - audit.written
    let count = try file.write(data[..<length])
    audit.written += count
    if audit.written == audit.cut: error(io.failed, "backup post-write failure")
    return count

func read(raw: void*?, file: files.File*, data: u8[]) -> usize!:
    let audit = state(raw)
    audit.reads += 1
    if audit.kind == 8: error(io.failed, "backup verify-read failure")
    if audit.kind == 21: return data.length + 1
    if audit.kind == 22: return 0
    if audit.kind == 20 and data.length > 1: return try file.read(data[..<1])
    return try file.read(data)

func synchronize(raw: void*?, file: files.File*) -> !:
    let audit = state(raw)
    audit.syncs += 1
    if audit.kind == 6: error(io.failed, "backup sync failure")
    try file.sync()
    if audit.kind == 7: error(io.failed, "backup post-sync failure")

func publish(raw: void*?, directory: files.Directory*, source: c.str, target: c.str, possible: bool*) -> !:
    let audit = state(raw)
    audit.publications += 1
    assert(audit.syncs == 1 and audit.reads > 0)
    if audit.kind == 9: error(io.failed, "backup pre-publication failure")
    if audit.kind == 19:
        *possible = true
        error(io.failed, "backup indeterminate rename failure")
    if audit.kind == 16:
        var sentinel = try directory.open_file(target, files.OpenMode.create_new_read_write)
        defer sentinel.destroy()
        try io.write_all(&sentinel, b"unrelated collision sentinel")
    try storage.publish(none, directory, source, target, possible)
    if audit.kind == 10: error(io.failed, "backup post-publication failure")

func directory_sync(raw: void*?, directory: files.Directory*) -> !:
    let audit = state(raw)
    audit.directories += 1
    assert(audit.publications == 1)
    if audit.kind == 11: error(io.failed, "backup directory sync failure")
    try storage.sync_directory(directory)
    if audit.kind == 12: error(io.failed, "backup post-directory-sync failure")

func close(raw: void*?, file: files.File*) -> !:
    let audit = state(raw)
    audit.closes += 1
    assert(audit.directories == 1)
    if audit.kind == 13: error(io.failed, "backup close failure")
    try file.close()
    if audit.kind == 14: error(io.failed, "backup post-close failure")

func remove(raw: void*?, directory: files.Directory*, name: c.str) -> !:
    let audit = state(raw)
    audit.removed += 1
    if audit.kind == 15: error(io.failed, "backup cleanup failure")
    try storage.remove(none, directory, name)

func one(store: engine.Store*, path: str, kind: usize, cut: usize = 18446744073709551615) -> !:
    var audit = Audit(kind = kind, cut = cut)
    let controls = storage.Controls(context = &audit, random = random, create = create,
        read = read, write = write, sync = synchronize, publish = publish,
        directory_sync = directory_sync, close = close, remove = remove)
    let parent = try strings.copy(paths.directory(path))
    defer strings.release(parent)
    var directory = try files.Directory.open((c.str)parent)
    defer directory.destroy()
    let collision = ".luce-backup-00000000000000000000000000000000"
    if kind == 17 or kind == 18:
        var sentinel = try directory.open_file((c.str)collision, files.OpenMode.create_new_read_write)
        try io.write_all(&sentinel, b"unrelated collision sentinel")
        sentinel.destroy()
    let success = (kind == 0 and cut == 18446744073709551615) or kind == 3 or kind == 18 or kind == 20
    let late = (kind >= 10 and kind <= 14) or kind == 19
    var refused = false
    discard(engine.backup_to(store, path, controls) catch failure:
        assert(not success and ((failure.code == uncertain) == late))
        if kind == 16: assert(failure.code == files.already_exists)
        if kind == 17: assert(failure.code == busy)
        if kind == 15: assert(failure.code == io.failed)
        refused = true
        recover backup.Info(0, 0, 0))
    assert(refused != success)
    let stats = engine.statistics(store)
    assert(stats.generation == 1 and stats.records == 1 and not stats.needs_reopen and stats.active_views == 0)
    let present: files.Metadata? = files.metadata((c.str)path, follow_symlinks = false) catch failure:
        assert(failure.code == files.missing)
        recover none
    let has_backup = success or (kind >= 10 and kind <= 14)
    assert((present != none) == (has_backup or kind == 16))
    if has_backup:
        let info = try backup.verify(path)
        assert(info.generation == 1 and info.records == 1 and info.bytes == 94)
        ## Ordinary ownership succeeds again after all destination error paths.
        let restored = try engine.open(path)
        assert(engine.statistics(restored).generation == 1)
        engine.drop(restored)
    if kind == 16:
        let data = try files.read_limit((c.str)path, 4096)
        defer free(data)
        assert((str)data == "unrelated collision sentinel")
    if kind == 17 or kind == 18:
        assert(audit.randoms == (128 if kind == 17 else 3))
        var sentinel = try directory.open_file((c.str)collision)
        var data: u8[28]
        try io.read_exact(&sentinel, data)
        assert((str)data == "unrelated collision sentinel")
        sentinel.destroy()
        try storage.remove(none, &directory, (c.str)collision)
    if audit.name_size > 0:
        let name = (str)audit.name[..<audit.name_size]
        let remains: files.Metadata? = directory.entry_metadata((c.str)name, follow_symlinks = false) catch failure:
            assert(failure.code == files.missing)
            recover none
        assert((remains != none) == (kind == 15))
        if kind == 15: try storage.remove(none, &directory, (c.str)name)
    if not has_backup and kind != 16:
        assert((try engine.backup_to(store, path)).generation == 1)

pub func main(arguments: str[]) -> i32!:
    assert(arguments.length == 2)
    let store = try engine.open(arguments[1])
    defer engine.drop(store)
    var tx = try engine.transaction(store)
    defer tx.close()
    try tx.put("key", b"val")
    assert(try tx.commit() == 1)
    var cases: usize
    for kind in 0..<23:
        var scratch: u8[4096]
        try one(store, try format(scratch, f"{arguments[1]}-kind-{kind}"), (usize)kind)
        cases += 1
    for cut in 0..<95:
        var scratch: u8[4096]
        try one(store, try format(scratch, f"{arguments[1]}-cut-{cut}"), 0, (usize)cut)
        cases += 1
    print(f"PASS {cases} backup entropy/create/read/write/verify/sync/publication/close/cleanup/collision failures and retries")
    return 0
