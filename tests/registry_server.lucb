## LOOPBACK TEST FIXTURE ONLY. No authentication; never deploy as a registry.
## Tests database transactions on real luce-server application workers.
import db
import http
import interop
import thread
import memory
import io
import files

var shared_database: db.Database*?
var shared_path: str
var active: @u64
var peak: @u64

func failed(code: ErrorCode, message: str) -> interop.Outcome[interop.Reference[http.Response]]:
    let copied = interop.copy_text(message) catch failure:
        return interop.Outcome[interop.Reference[http.Response]].failure(failure.code, interop.Owned[str]("allocation failed"))
    return interop.Outcome[interop.Reference[http.Response]].failure(code, copied)

func reply(text: str, status: i64 = 200) -> interop.Outcome[interop.Reference[http.Response]]:
    let response = http.Response.bytes(text.bytes, "text/plain", status) catch failure: return failed(failure.code, failure.message)
    return interop.Outcome[interop.Reference[http.Response]].success(interop.Owned[interop.Reference[http.Response]](response, &response.owner.header))

struct Handlers:
    var reserved: bool

    func claim(request: interop.View[http.Request]) -> interop.Outcome[interop.Reference[http.Response]]:
        let database = shared_database else trap("missing database")
        let name = request.value().parameter("name") else return reply("missing name", 400)
        if name.length == 0 or name.length > 32: return reply("invalid name", 400)
        for byte in name.bytes:
            if not ((byte >= 'a' and byte <= 'z') or (byte >= '0' and byte <= '9')):
                return reply("invalid name", 400)
        let concurrent = active.add(1, .acq_rel) + 1
        defer discard(active.sub(1, .acq_rel))
        var observed = peak.load(.acquire)
        while observed < concurrent:
            let (changed, previous) = peak.cas(observed, concurrent, .acq_rel, .acquire)
            if changed: break
            observed = previous
        thread.sleep(10)
        var buffer: u8[128]
        let key = format(buffer, f"user/{name}") catch failure: return failed(failure.code, failure.message)
        for attempt in 0..<128:
            let tx = database.begin() catch failure: return failed(failure.code, failure.message)
            defer tx.release()
            let available = tx.value().contains("invite/test-only") catch failure: return failed(failure.code, failure.message)
            if not available: return reply("invitation consumed", 409)
            tx.value().remove("invite/test-only") catch failure: return failed(failure.code, failure.message)
            tx.value().insert_text(key, name) catch failure: return failed(failure.code, failure.message)
            tx.value().put_text("audit/registration", name) catch failure: return failed(failure.code, failure.message)
            let committed = tx.value().commit(wait_ms = 1000) catch failure:
                if failure.code != db.busy and failure.code != db.conflict and failure.code != db.timed_out: return failed(failure.code, failure.message)
                thread.sleep(1)
                recover -1
            if committed > 0: return reply("created", 201)
        return reply("retry later", 503)

    func state(request: interop.View[http.Request]) -> interop.Outcome[interop.Reference[http.Response]]:
        discard(request)
        let database = shared_database else trap("missing database")
        let snapshot = database.snapshot() catch failure: return failed(failure.code, failure.message)
        defer snapshot.release()
        let count = snapshot.value().count() catch failure: return failed(failure.code, failure.message)
        let generation = snapshot.value().generation() catch failure: return failed(failure.code, failure.message)
        var scratch: u8[128]
        let text = format(scratch, f"{generation} {count} {peak.load(.acquire)}") catch failure: return failed(failure.code, failure.message)
        return reply(text)

    func stop(request: interop.View[http.Request]) -> interop.Outcome[interop.Reference[http.Response]]:
        discard(request)
        let response = http.Response.bytes(b"bye") catch failure: return failed(failure.code, failure.message)
        response.value().shutdown_after() catch failure:
            response.release()
            return failed(failure.code, failure.message)
        return interop.Outcome[interop.Reference[http.Response]].success(interop.Owned[interop.Reference[http.Response]](response, &response.owner.header))

    func compact(request: interop.View[http.Request]) -> interop.Outcome[interop.Reference[http.Response]]:
        discard(request)
        let database = shared_database else trap("missing database")
        let generation = database.checkpoint(wait_ms = 1000) catch failure: return failed(failure.code, failure.message)
        var scratch: u8[32]
        let text = format(scratch, f"{generation}") catch failure: return failed(failure.code, failure.message)
        return reply(text)

    func export_backup(request: interop.View[http.Request]) -> interop.Outcome[interop.Reference[http.Response]]:
        let database = shared_database else trap("missing database")
        let slot = request.value().parameter("slot") else return reply("missing slot", 400)
        if slot != "0" and slot != "1": return reply("invalid test slot", 400)
        var path_buffer: u8[4096]
        let path = format(path_buffer, f"{shared_path}.backup-{slot}") catch failure: return failed(failure.code, failure.message)
        let info = database.backup(path) catch failure:
            if failure.code == db.busy or failure.code == files.already_exists: return reply("destination unavailable", 409)
            ## Disposable fixture: surface diagnostics to the independent checker.
            return reply(failure.message, 500)
        var scratch: u8[128]
        let text = format(scratch, f"{info.generation} {info.records} {info.bytes}") catch failure: return failed(failure.code, failure.message)
        return reply(text, 201)

    mutating func close(): discard(())

func configure(data: str) -> interop.Outcome[http.Application]:
    discard(data)
    let native = new Handlers() catch failure: trap(failure.message)
    let handlers = interop.Reference[Handlers].adopt(native, interop.Type[Handlers]("registry fixture", Handlers.close)) catch failure: trap(failure.message)
    defer handlers.release()
    var router = http.Router() catch failure: trap(failure.message)
    defer router.close()
    let claim = http.Handler.bind(handlers, Handlers.claim) catch failure: trap(failure.message)
    defer claim.release()
    router.post("/claim/{name}", claim) catch failure: trap(failure.message)
    let state = http.Handler.bind(handlers, Handlers.state) catch failure: trap(failure.message)
    defer state.release()
    router.get("/state", state) catch failure: trap(failure.message)
    let stop = http.Handler.bind(handlers, Handlers.stop) catch failure: trap(failure.message)
    defer stop.release()
    router.post("/stop", stop) catch failure: trap(failure.message)
    let compact = http.Handler.bind(handlers, Handlers.compact) catch failure: trap(failure.message)
    defer compact.release()
    router.post("/checkpoint", compact) catch failure: trap(failure.message)
    let exporter = http.Handler.bind(handlers, Handlers.export_backup) catch failure: trap(failure.message)
    defer exporter.release()
    router.post("/backup/{slot}", exporter) catch failure: trap(failure.message)
    let result = router.application() catch failure: trap(failure.message)
    return interop.Outcome[http.Application].success(interop.Owned[http.Application](result, result.owner))

pub func main(arguments: str[]) -> i32!:
    assert(arguments.length == 2)
    let database = try new db.Database(arguments[1]) in memory.heap
    defer free(database) in memory.heap
    defer database.close()
    shared_database = database
    shared_path = arguments[1]
    let snapshot = try database.snapshot()
    defer snapshot.release()
    if try snapshot.value().generation() == 0:
        let tx = try database.begin()
        defer tx.release()
        try tx.value().put_text("invite/test-only", "one claim")
        discard(try tx.value().commit())
    var server = try http.Server(http.ServerConfig(address = "127.0.0.1", port = 0, network_workers = 4, application_workers = 4,
        body_limit = 1024, memory_body_limit = 1024, application_timeout_ms = 5000),
        interop.WorkerEntry[str, unit, unit].native(configure))
    defer server.close()
    try server.start()
    print(f"READY {try server.port()}")
    try io.flush_stdout()
    try server.run()
    return 0
