## Disposable process fixture for independent format-002 and recovery verification.
import db
import memory

pub func main(arguments: str[]) -> i32!:
    assert(arguments.length == 3)
    var database = try db.Database(arguments[2])
    defer database.close()
    if arguments[1] == "write":
        let first = try database.begin()
        defer first.release()
        try first.value().put_text("user/alice", "Alice")
        try first.value().put("binary", b"\0\xff\x7f")
        try first.value().put("empty", b"")
        assert(try first.value().commit() == 1)
        let second = try database.begin()
        defer second.release()
        try second.value().remove("user/alice")
        try second.value().put_text("user/bob", "Bob")
        assert(try second.value().commit() == 2)
        let third = try database.begin()
        defer third.release()
        try third.value().put("binary", b"new\0\xff")
        try third.value().put_text("unicode/猫", "value")
        assert(try third.value().commit() == 3)
    elif arguments[1] == "compact":
        print(f"CHECKPOINT {try database.checkpoint(1000)}")
    elif arguments[1] == "append":
        let tx = try database.begin()
        defer tx.release()
        try tx.value().put_text("after", "recovery")
        print(f"COMMIT {try tx.value().commit()}")
    elif arguments[1] == "large" or arguments[1] == "quick":
        let length: usize = 1048576 if arguments[1] == "large" else 131073
        let count: usize = 18 if arguments[1] == "large" else 2
        let data = try alloc u8[length] in memory.heap
        defer free(data) in memory.heap
        for i in 0..<length: data[i] = (u8)(i % 251)
        for i in 0..<count:
            let tx = try database.begin()
            defer tx.release()
            var scratch: u8[32]
            try tx.value().put(try format(scratch, f"large/{i}"), data)
            assert(try tx.value().commit() == (i64)i + 1)
        assert(try database.checkpoint() == (i64)count)
    let snapshot = try database.snapshot()
    defer snapshot.release()
    print(f"STATE {try snapshot.value().generation()} {try snapshot.value().count()}")
    return 0
