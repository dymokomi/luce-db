## Database server over prism.Store.
import files
import c
import interop
import db
import prism

pub func main(arguments: str[]) -> i32!:
    assert(arguments.length == 2)
    let path = arguments[1]
    var refused = false
    let denied: interop.Reference[db.Database]? = db.Database.open(path, "") catch failure:
        assert(failure.code == prism.invalid)
        refused = true
        recover none
    if let extra = denied:
        extra.release()
        assert(false)
    assert(refused)
    assert(not files.exists((c.str)path))
    let database = try db.Database.open(path, "secret")
    defer database.release()
    let tx = try database.value().begin()
    defer tx.release()
    try tx.value().add("/notes", "file")
    let text = try prism.Value.text("hello")
    defer text.release()
    try tx.value().set("/notes", "text", text)
    discard(try tx.value().commit())
    tx.value().close()
    discard(try database.value().bake())
    let snap = try database.value().snapshot()
    defer snap.release()
    let got = try snap.value().get("/notes", "text")
    defer got.release()
    assert(try got.value().text_at() == "hello")
    let backing = try database.value().store()
    let retained = try backing.snapshot()
    defer retained.release()
    database.value().close()
    database.value().close()
    let after_close = try retained.value().get("/notes", "text")
    defer after_close.release()
    assert(try after_close.value().text_at() == "hello")
    var rejected = false
    let missing: prism.Store*? = database.value().store() catch failure:
        assert(failure.code == prism.closed)
        rejected = true
        recover none
    assert(rejected and missing == none)
    print("PASS luce-db server over prism.Store")
    return 0
