import db
import interop
import memory

func duplicate(path: str) -> !:
    var connection = try db.Database(path)
    defer connection.close()

pub func main(arguments: str[]) -> i32!:
    assert(arguments.length == 2)
    var database = try db.Database(arguments[1])
    defer database.close()
    var refused = false
    duplicate(arguments[1]) catch failure:
        assert(failure.code == db.busy)
        refused = true
    assert(refused)
    let tx = try database.begin()
    defer tx.release()
    try tx.value().put_text("empty", "")
    let empty = (try tx.value().get("empty")) else trap("empty is not absent")
    defer empty.release()
    assert((try empty.value().bytes()).length == 0)
    assert(try tx.value().get("absent") == none)
    refused = false
    tx.value().insert_text("empty", "duplicate") catch failure:
        assert(failure.code == db.conflict)
        refused = true
    assert(refused)
    refused = false
    tx.value().put_text("", "invalid") catch failure:
        assert(failure.code == db.invalid)
        refused = true
    assert(refused)
    var key: u8[1025]
    for index in 0..<key.length: key[index] = 'x'
    try tx.value().put((str)key[..<1024], b"max-key")
    refused = false
    tx.value().put((str)key, b"too long") catch failure:
        assert(failure.code == db.invalid)
        refused = true
    assert(refused)
    refused = false
    let malformed_key = b"\xff"
    tx.value().put((str)malformed_key, b"bad UTF-8") catch failure:
        assert(failure.code == db.invalid)
        refused = true
    assert(refused)
    let large = try alloc u8[1048577] in memory.heap
    defer free(large) in memory.heap
    for index in 0..<large.length: large[index] = 0
    try tx.value().put("max-value", large[..<1048576])
    refused = false
    tx.value().put("too-large", large) catch failure:
        assert(failure.code == db.limit_exceeded)
        refused = true
    assert(refused)
    try tx.value().put("binary", b"\xff\0")
    let binary = (try tx.value().get("binary")) else trap("missing binary")
    defer binary.release()
    refused = false
    discard(binary.value().text() catch failure:
        assert(failure.code == db.invalid)
        refused = true
        recover "")
    assert(refused)
    assert(try tx.value().commit() == 1)
    refused = false
    tx.value().put_text("closed", "no") catch failure:
        assert(failure.code == db.closed)
        refused = true
    assert(refused)
    let abandoned = try database.begin()
    try abandoned.value().put_text("rollback", "no")
    abandoned.release()
    let unchanged = try database.begin()
    assert(try unchanged.value().commit() == 1)
    unchanged.release()
    var views: (interop.Reference[db.Snapshot]?)[1024]
    for index in 0..<1024: views[index] = try database.snapshot()
    refused = false
    let extra: interop.Reference[db.Snapshot]? = database.snapshot() catch failure:
        assert(failure.code == db.limit_exceeded)
        refused = true
        recover none
    assert(refused and extra == none)
    for entry in views:
        let snapshot = entry else trap("missing view")
        snapshot.release()
    let last = try database.snapshot()
    defer last.release()
    assert(not try last.value().contains("rollback"))
    assert(try last.value().count() == 4)
    database.close()
    assert(try last.value().count() == 4)
    last.close()
    try duplicate(arguments[1])
    assert((try binary.value().bytes()).length == 2)
    print("PASS limits, invalid input, binary/empty values, rollback, ownership, lock lifetime")
    return 0
