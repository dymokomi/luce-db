import db

pub func main(arguments: str[]) -> i32!:
    assert(arguments.length == 2)
    var database = try db.Database(arguments[1])
    defer database.close()
    let before = try database.snapshot()
    defer before.release()
    assert(try before.value().count() == 0)
    let tx = try database.begin()
    defer tx.release()
    try tx.value().put_text("user/alice", "Alice")
    try tx.value().put_text("package/test", "v1")
    var invalid_waits: usize
    for wait in [-1, 60001]:
        discard(tx.value().commit(wait) catch failure:
            assert(failure.code == db.invalid)
            invalid_waits += 1
            recover -1)
    assert(invalid_waits == 2)
    assert((try database.statistics()).generation == 0)
    assert((try database.statistics()).journal_bytes == 16)
    let read = (try tx.value().get("user/alice")) else trap("read your writes")
    defer read.release()
    assert(try read.value().text() == "Alice")
    assert(try tx.value().commit() == 1)
    assert(try before.value().count() == 0)
    let snapshot = try database.snapshot()
    defer snapshot.release()
    assert(try snapshot.value().count() == 2)
    assert(try snapshot.value().key_at(0) == "package/test")
    let stale = try database.begin()
    defer stale.release()
    let winner = try database.begin()
    defer winner.release()
    try winner.value().remove("package/test")
    assert(try winner.value().commit() == 2)
    try stale.value().put_text("orphan", "must not commit")
    var rejected = false
    discard(stale.value().commit() catch failure:
        assert(failure.code == db.conflict)
        rejected = true
        recover -1)
    assert(rejected)
    let statistics = try database.statistics()
    assert(statistics.generation == 2 and statistics.records == 1)
    assert(statistics.journal_bytes == 148)
    assert(statistics.conflicted_commits == 1)
    assert(statistics.queued_attempts == 0 and statistics.waiting_writers == 0)
    assert(try snapshot.value().count() == 2)
    print("PASS transactions, snapshots, ordering, read-your-writes, conflicts")
    return 0
